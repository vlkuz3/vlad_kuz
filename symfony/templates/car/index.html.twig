{% extends 'base.html.twig' %}
{% block title %}Cars{% endblock %}
{% block body %}
    <h1>Car List</h1>

    <a href="{{ path('car_new') }}">Create New Car</a>

    <table>
        <thead>
            <tr>
                <th>Model</th>
                <th>Year</th>
                <th>Color</th>
                <th>Car Category</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for car in cars %}
            <tr>
                <td>{{ car.model }}</td>
                <td>{{ car.year }}</td>
                <td>{{ car.color }}</td>
                <td>{{ car.carCategory.name }}</td>
                <td>
                    <a href="{{ path('car_edit', {'id': car.id}) }}">Edit</a> |
                    <a href="{{ path('car_delete', {'id': car.id}) }}">Delete</a>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="6">No cars found.</td></tr>
        {% endfor %}
        </tbody>
    </table>
{% endblock %}
