{% extends 'base.html.twig' %}
{% block title %}Cars{% endblock %}
{% block body %}
    <h1>Car List</h1>
    <a href="{{ path('car_new') }}">Create Car</a>

    <form method="get" action="{{ path('car_index') }}">
        <label for="model">Model</label>
        <input type="text" name="model" value="{{ filters.model ?? '' }}">

        <label for="year">Year</label>
        <input type="number" name="year" value="{{ filters.year ?? '' }}">

        <label for="color">Color</label>
        <input type="text" name="color" value="{{ filters.color ?? '' }}">

        <label for="carCategory">Car Category</label>
        <select name="carCategory">
            <option value="">All Categories</option>
            {% for category in carCategories %}
                <option value="{{ category.id }}"
                    {{ filters.carCategory is defined and filters.carCategory == category.id ? 'selected' : '' }}>
                    {{ category.name }}
                </option>
            {% endfor %}
        </select>

        <label for="itemsPerPage">Items Per Page</label>
        <select name="itemsPerPage" class="form-select">
            {% for size in [5, 10, 15, 20] %}
                <option value="{{ size }}"
                    {{ filters.itemsPerPage is defined ? (filters.itemsPerPage == size ? 'selected' : '') : (size == 5 ? 'selected' : '') }}>
                    {{ size }}
                </option>
            {% endfor %}
        </select>


        <button type="submit">Filter</button>
    </form>

    <a href="{{ path('car_index') }}">Reset Filters</a>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Model</th>
                <th>Year</th>
                <th>Color</th>
                <th>Car Category</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for car in cars %}
            <tr>
                <td>{{ car.id }}</td>
                <td>{{ car.model }}</td>
                <td>{{ car.year }}</td>
                <td>{{ car.color }}</td>
                <td>{{ car.carCategory.name }}</td>
                <td>
                    <a href="{{ path('car_edit', {'id': car.id}) }}">Edit</a> |
                    <a href="{{ path('car_delete', {'id': car.id}) }}">Delete</a>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="6">No cars found.</td></tr>
        {% endfor %}
        </tbody>
    </table>
    <div class="d-flex justify-content-center mt-4">
        {{ knp_pagination_render(cars) }}
    </div>


{% endblock %}