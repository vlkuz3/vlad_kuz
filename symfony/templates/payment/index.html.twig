{% extends 'base.html.twig' %}

{% block title %}Payments{% endblock %}

{% block body %}
    <h1>Payment List</h1>

    <form method="get">
        <input type="text" name="customer" value="{{ filters.customer ?? '' }}" placeholder="Search by customer">

        <input type="date" name="paymentDate" value="{{ filters.paymentDate ?? '' }}" placeholder="Payment date">

        <select name="itemsPerPage">
            {% for size in [5, 10, 15, 20] %}
                <option value="{{ size }}"
                    {{ filters.itemsPerPage is defined and filters.itemsPerPage == size ? 'selected' : '' }}>
                    {{ size }}
                </option>
            {% endfor %}
        </select>

        <button type="submit">Apply</button>
    </form>
    <a href="{{ path('payment_index') }}">Reset Filters</a>

    <table class="table">
        <thead>
            <tr>
                <th>Rental</th>
                <th>Customer</th>
                <th>Amount</th>
                <th>Payment Date</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for payment in payments %}
            <tr>
                <td>Rental #{{ payment.rental.id }}</td>
                <td>{{ payment.rental.customer.name }}</td>
                <td>{{ payment.amount }} грн</td>
                <td>{{ payment.paymentDate|date('Y-m-d') }}</td>
                <td>
                    <a href="{{ path('payment_edit', {'id': payment.id}) }}">Edit</a>
                    <a href="{{ path('payment_delete', {'id': payment.id}) }}">Delete</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">No records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>


    <div class="d-flex justify-content-center">
        {{ knp_pagination_render(payments) }}
    </div>

    <a href="{{ path('payment_new') }}">Create New Payment</a>
{% endblock %}
