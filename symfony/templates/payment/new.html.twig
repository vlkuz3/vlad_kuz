{% extends 'base.html.twig' %}
{% block title %}{{ form.vars.value.id ? 'Edit' : 'Create' }} Payment{% endblock %}
{% block body %}
    <h1>{{ form.vars.value.id ? 'Edit' : 'Create' }} Payment</h1>
    {{ form_start(form) }}
        {{ form_row(form.rental) }}
        {{ form_row(form.amount) }}
        {{ form_row(form.paymentDate) }}
        {{ form_row(form.save) }}
    {{ form_end(form) }}
{% endblock %}
